LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:4b
# Seconds to wait for the LLM inference server to respond before giving up.
LLM_TIMEOUT_SECONDS=30
# Optional. For "thinking" models like qwen3, this suppresses the model's
# internal reasoning output. JobFit only needs the final structured JSON
# (extraction/matching both use JSON response mode), so the reasoning step is
# pure overhead here — benchmarks showed it cutting per-call latency roughly
# 10x for this app's prompts. Leave unset to keep the model's default behavior.
LLM_REASONING_EFFORT=none
DATABASE_PATH=./jobfit.db
